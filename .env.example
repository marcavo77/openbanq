# ============================================================================
# OPEN BANQUE - VARIABLES D'ENVIRONNEMENT ET ACCÈS AUTOMATISÉS
# ============================================================================
# Copiez ce fichier sous le nom '.env' et remplissez les valeurs.
# Ce fichier '.env' est déjà ignoré par Git (.gitignore) et restera strictement sur votre machine.

# ----------------------------------------------------------------------------
# 1. ACCÈS SUPABASE (Pour initialiser la base et exécuter les requêtes SQL)
# ----------------------------------------------------------------------------
# URL de votre projet (Dashboard Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique 'anon' (Dashboard Supabase > Project Settings > API)
VITE_SUPABASE_ANON_KEY=votre_cle_anon_ici

# Clé secrète 'service_role' (Dashboard Supabase > Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_ici

# Token d'accès personnel Supabase (Permet à l'agent d'exécuter les SQL à votre place)
# À générer en 1 clic sur : https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_votre_token_ici

# ID de référence du projet (ex: abcdefghijklmno dans l'URL de votre projet Supabase)
SUPABASE_PROJECT_REF=votre_project_ref_ici


# ----------------------------------------------------------------------------
# 2. ACCÈS VERCEL (Pour déployer et configurer le projet automatiquement)
# ----------------------------------------------------------------------------
# Token personnel Vercel (Permet à l'agent de déployer en production à votre place)
# À générer en 1 clic sur : https://vercel.com/account/tokens
VERCEL_TOKEN=votre_token_vercel_ici


# ----------------------------------------------------------------------------
# 3. SERVICE EMAIL (Optionnel - pour les e-mails de bienvenue et validations)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@openbanque.com
SMTP_PASSWORD=
CONTACT_EMAIL=contact@openbanque.com
FROM_EMAIL=contact@openbanque.com
